{
  "name": "winplaybox-video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Modular 9:16 Remotion video production platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"engines/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "jest --runInBand",
    "remotion:preview": "remotion studio apps/studio/src/remotion/index.ts",
    "render:orbit": "remotion render apps/studio/src/remotion/index.ts OrbitPuzzle output/orbit-puzzle.mp4",
    "render:traffic": "remotion render apps/studio/src/remotion/index.ts TrafficPuzzle output/traffic-puzzle.mp4",
    "render:sanatan": "remotion render apps/studio/src/remotion/index.ts SanatanStory output/sanatan-story.mp4",
    "render:all": "npm run render:orbit && npm run render:traffic && npm run render:sanatan",
    "build": "tsc --project tsconfig.build.json",
    "quality:render": "ts-node scripts/verify-render.ts",
    "render:engine": "ts-node scripts/render-engine.ts",
    "validate:engine": "ts-node scripts/validate-engine.ts",
    "manifest:render": "ts-node scripts/write-render-manifest.ts",
    "post": "ts-node scripts/post.ts",
    "auth:youtube": "node scripts/publish/auth-youtube.mjs",
    "engine:new": "node scripts/new-engine.mjs",
    "engine:qa": "ts-node scripts/engine-qa.ts",
    "engine:lock": "ts-node scripts/lock-published.ts"
  },
  "dependencies": {
    "@react-three/drei": "9.120.3",
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.257",
    "@remotion/media-utils": "4.0.257",
    "googleapis": "^144.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.257",
    "three": "0.169.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "eslint": "9.15.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
