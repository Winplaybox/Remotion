{
  "name": "pdf2shorts-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Converts research PDFs into Hinglish educational YouTube Shorts via Remotion",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "jest",
    "remotion:preview": "npx remotion studio src/remotion/index.ts",
    "render": "npx remotion render src/remotion/index.ts",
    "audit:scheduled": "ts-node automation/orchestrator.ts",
    "phase0:audit": "ts-node automation/phase0-audit.ts",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.257",
    "@remotion/compositor-win32-x64-msvc": "4.0.257",
    "@remotion/media-utils": "4.0.257",
    "@react-three/fiber": "8.17.10",
    "@react-three/drei": "9.120.3",
    "remotion": "4.0.257",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@types/node": "22.9.0",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "eslint": "9.15.0",
    "jest": "29.7.0",
    "@types/jest": "29.5.14",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
