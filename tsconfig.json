{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["packages/core/src/*"],
      "@research/*": ["packages/research/src/*"],
      "@editorial/*": ["packages/editorial/src/*"],
      "@storyboard/*": ["packages/storyboard/src/*"],
      "@media/*": ["packages/media/src/*"],
      "@quality/*": ["packages/quality/src/*"],
      "@schemas/*": ["schemas/*"]
    },
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*",
    "packages/**/*",
    "schemas/**/*",
    "automation/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "output"
  ]
}
