        {
          "text": "अपनी माँ रानी के साथ रहता था।",
          "start": 4.83,
          "end": 7.23
        },
        {
          "text": "चिंटू को तेज़ दौड़ना बहुत पसंद था।",
          "start": 7.45,
          "end": 10.354
        }
      ]
    },
    {
      "kind": "story",
      "narration": "एक सुबह उसने एक चमकती नीली तितली देखी। मैं इसे पकड़ूँगा! वो चिल्लाया, और उसके पीछे भागा।",
      "seconds": 6.8,
      "audio": "mindnest-v2/audio/fable-1/hi/page-2.mp3",
      "audioSeconds": 7.632,
      "cues": [
        {
          "text": "एक सुबह उसने एक चमकती नीली तितली देखी। मैं इसे पकड़ूँगा!",
          "start": 0,
          "end": 4.737
        },
        {
          "text": "वो चिल्लाया, और उसके पीछे भागा।",
          "start": 4.957,
          "end": 7.599
        }
      ]
    },
    {
      "kind": "story",
      "narration": "पर वो जितना तेज़ भागता, तितली उतनी तेज़ उड़ती। छपाक! चिंटू फिसला और कीचड़ में गिर गया।",
      "seconds": 6.6,
      "audio": "mindnest-v2/audio/fable-1/hi/page-3.mp3",
      "audioSeconds": 7.128,
      "cues": [
        {
          "text": "पर वो जितना तेज़ भागता, तितली उतनी तेज़ उड़ती। छपाक!",
          "start": 0,
